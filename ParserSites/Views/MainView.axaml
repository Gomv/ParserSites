<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ParserSites.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ParserSites.Views.MainView"
             x:DataType="vm:MainViewModel">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="500" MinWidth="500"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" MinWidth="500">

            <Grid.Background>
                <SolidColorBrush Color="Silver" Opacity=".3"/>
            </Grid.Background>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="5 5 0 0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="25"/>
                </Grid.ColumnDefinitions>
            
                <TextBox Grid.Column="0"
                         PlaceholderText="Введите сайт для парсинга" 
                         VerticalAlignment="Top" 
                         CornerRadius="3 0 0 0"
                         HorizontalAlignment="Stretch"
                         x:Name="SiteAddress"
                         BorderBrush="Black"
                         BorderThickness=".5">
                </TextBox>

                <Button Grid.Column="1"
                         VerticalAlignment="Top" 
                         HorizontalAlignment="Stretch"
                         Content = "..."
                         CornerRadius="0 3 0 0"
                         Height="{Binding #SiteAddress.Bounds.Height}"
                         Background="Transparent"
                         BorderBrush="Black"
                         Click="Button_Click"
                         IsEnabled="{Binding #SiteAddress, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         BorderThickness="0 .5 .5 .5">
                    <Button.Styles>
                        <Style Selector="Button:disabled">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Style>
                    </Button.Styles>
                </Button>

            </Grid>

            <Grid Grid.Row="1" Margin="5 .75 0 5">
                <ListBox BorderBrush="Black" BorderThickness=".5" DataContext="{Binding GetSite}">
                    
                </ListBox>
            </Grid>


        </Grid>

        <GridSplitter Width=".1"
                      Padding="0"
                      BorderThickness="0 0 0 0" 
                      Margin="0"
                      Grid.Column="1">

            <GridSplitter.Background>
                <SolidColorBrush Color="Silver" Opacity=".3"/>
            </GridSplitter.Background>

        </GridSplitter>

        <Grid Grid.Column="2">
            <Grid.Background>
                <SolidColorBrush Color="WhiteSmoke" Opacity=".35"/>
            </Grid.Background>

            <Grid>
                <TabControl Margin="5">
                    <TabItem Header="Данные с сайта">
                    </TabItem>
                    <TabItem Header="Табличный вариант">
                    </TabItem>
                </TabControl>
            </Grid>

        </Grid>
        

    </Grid>
</UserControl>
